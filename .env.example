# ============================================
# 상세페이지 에이전트 팀 — 환경변수 설정
# cp .env.example .env 후 실제 값 입력
# ============================================

# Claude (에이전트 실행용)
ANTHROPIC_API_KEY=sk-ant-xxxx

# Gemini Pro (분석, 콘텐츠 평가용)
GEMINI_API_KEY=AIzaxxxx

# GA4 설정
GA4_PROPERTY_ID=123456789
GA4_SERVICE_ACCOUNT_JSON=./secrets/ga4_service_account.json

# 배포 설정 (자체 서버)
DEPLOY_TARGET=http://localhost:8000
DEPLOY_API_KEY=

# 네이버 쇼핑 (선택)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 디버그 모드
DEBUG=false
